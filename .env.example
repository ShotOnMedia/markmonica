APP_NAME=MarkMonica
ENVIRONMENT=development
APP_URL=https://events.example.com

POSTGRES_DB=markmonica
POSTGRES_USER=markmonica
POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql+psycopg://markmonica:change-me-now@db:5432/markmonica

REDIS_URL=redis://redis:6379/0
WORKER_QUEUE=markmonica:jobs

# MarkMonica expects an external S3-compatible object store. The browser-facing
# endpoint must be HTTPS and must allow CORS from APP_URL.
S3_ENDPOINT_URL=https://uploads.example.com
S3_PUBLIC_ENDPOINT_URL=https://uploads.example.com
S3_ACCESS_KEY=markmonica
S3_SECRET_KEY=change-me-now
S3_BUCKET=markmonica
S3_REGION=auto
S3_AUTO_CREATE_BUCKET=false
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_EXPIRY_SECONDS=900
MAX_IMAGE_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=500
GUEST_UPLOAD_RATE_LIMIT_PER_MINUTE=30
STALE_UPLOAD_HOURS=2
STALE_UPLOAD_CLEANUP_INTERVAL_SECONDS=900
